{
  "version": 2,
  "name": "disco-tools-website",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/tutorials", "destination": "/details", "permanent": true },
    { "source": "/tutorials.html", "destination": "/details", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
